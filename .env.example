# Salin ke apps/web/.env.local (bagian WEB) dan services/api/.env (bagian API).
# JANGAN commit nilai asli. Secret produksi disimpan di Secret Manager, bukan di file.

# ===== WEB (dibundel ke browser: hanya nilai publik) =====
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
# Tombol Google hanya bila provider sudah dikonfigurasi di Firebase Console
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# Kunci BROWSER Maps JavaScript API — HANYA untuk memuat peta, dibatasi HTTP referrer di
# Google Cloud Console (mis. localhost:3000/*). Kosong = peta gagal-anggun (tidak tampil).
# Places (pencarian tempat) TIDAK memakai kunci ini — itu lewat backend, lihat GOOGLE_MAPS_SERVER_API_KEY.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=
# Konfigurasi web Firebase bukan rahasia, tetapi tetap dipisah per project.
# Emulator memakai project "demo-placetogo" (tanpa layanan cloud).
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-placetogo
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-placetogo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# ===== API (server saja) =====
APP_ENV=development
PORT=8081  # 8080 dipakai emulator Firestore
LOG_LEVEL=info
FIREBASE_PROJECT_ID=demo-placetogo
WEB_ORIGIN=http://localhost:3000
# IP yang dikecualikan dari rate limit (uji lokal saja; ditolak saat APP_ENV=production)
RATE_LIMIT_ALLOWLIST=
# Emulator (hanya development; ditolak saat APP_ENV=production)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Kontrak eksternal (kosong di Fase 00; diisi via Secret Manager pada fase terkait)
# Kunci SERVER Places API (New) — dibatasi API/IP di Google Cloud Console, TIDAK PERNAH
# dikirim ke browser. Kosong = pencarian tempat menampilkan "belum dikonfigurasi".
GOOGLE_MAPS_SERVER_API_KEY=
DOKU_ENVIRONMENT=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
