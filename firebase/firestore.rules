rules_version = '2';

// Deny-by-default. Admin SDK (backend) melewati aturan ini, sehingga backend
// wajib memeriksa autentikasi/otorisasi/input sendiri. Semua penulisan bisnis
// (aktivitas, kapasitas, saldo, ledger, pembayaran, laporan) hanya lewat backend.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function onlyKeys(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    // Profil publik terpilih (displayName, avatarId, bio, cityId?, interests, createdAt).
    // Ditulis hanya oleh backend (PUT /v1/me/profile) agar penulisan users/{uid} dan
    // user_private/{uid} (profileComplete, preferensi privasi kota) tetap atomik dan
    // tervalidasi Zod di satu tempat (Fase 03). Semua pengguna masuk boleh membaca.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Data privat: hanya pemilik membaca. Penulisan lewat backend (Fase 02/03).
    match /user_private/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Ajakan: yang bukan draft dapat dibaca publik; draft hanya pembuat.
    // Semua penulisan (state machine, kapasitas) lewat backend/transaksi.
    match /activities/{activityId} {
      allow read: if resource.data.status != 'draft'
        || (signedIn() && resource.data.creatorId == request.auth.uid);
      allow write: if false;

      match /participants/{uid} {
        allow read: if isOwner(uid)
          || (signedIn() && get(/databases/$(database)/documents/activities/$(activityId)).data.creatorId == request.auth.uid);
        allow write: if false;
      }

      match /join_requests/{uid} {
        allow read: if isOwner(uid)
          || (signedIn() && get(/databases/$(database)/documents/activities/$(activityId)).data.creatorId == request.auth.uid);
        allow write: if false;
      }
    }

    // Chat: hanya anggota (memberIds). Penulisan dibuka di Fase 07 dengan validasi.
    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        allow write: if false;
      }
    }

    // Finansial: klien tidak pernah menulis. Saldo boleh dibaca pemilik;
    // ledger, payments, webhook_events tertutup total dari klien.
    match /wallets/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
    match /wallet_ledger/{id} {
      allow read, write: if false;
    }
    match /payments/{id} {
      allow read, write: if false;
    }
    match /webhook_events/{id} {
      allow read, write: if false;
    }

    // Apresiasi: pengirim/penerima membaca; penulisan lewat backend.
    match /appreciations/{id} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow write: if false;
    }

    // Laporan: identitas pelapor tidak boleh terbuka ke terlapor; hanya backend/moderator via API.
    match /reports/{id} {
      allow read, write: if false;
    }

    match /notifications/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Segala koleksi lain: ditolak.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
